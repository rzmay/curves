{
  "name": "curves",
  "version": "1.1.5",
  "description": "📈 Easily define and evaluate eased curves, similar to Unity's AnimationCurves with modifiers akin to Blender's FCurve Modifiers",
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robertmay2003/curves.git"
  },
  "homepage": "https://github.com/robertmay2003/curves#readme",
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "test": "npm run build && node build/tests/test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "curve",
    "easing",
    "ease",
    "keyframe",
    "animation",
    "modifier",
    "color",
    "vector3",
    "bezier",
    "cubic-bezier",
    "interpolate",
    "lerp"
  ],
  "author": "Robert May",
  "license": "ISC",
  "dependencies": {
    "color-convert": "^3.1.3",
    "color-string": "^2.1.4",
    "eaz": "^2.0.3",
    "simplex-noise": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.4",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^10.9.1",
    "rimraf": "^3.0.2",
    "tsdown": "^0.21.10",
    "typescript": "^5.9"
  }
}
